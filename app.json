{
  "expo": {
    "name": "DALAN",
    "slug": "DALAN",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dalan",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sowishi1738.DALAN",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-status-bar",
        {
          "style": "dark"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E8F7F1",
          "image": "./assets/images/dalan.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "Allow DALAN to use your location to show nearby reports"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow DALAN to use your precise location to show you on the map."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow DALAN to attach photos to your hazard report.",
          "cameraPermission": "Allow DALAN to take a photo for your hazard report.",
          "microphonePermission": false
        }
      ],
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "forceCxx20": true,
          "enableOpenCL": true
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
